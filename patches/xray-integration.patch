index 0000000..8e2a682
--- /dev/null
+++ b/app/src/main/java/io/nekohasekai/sagernet/bg/proto/XrayInstance.kt
@@ -0,0 +1,47 @@
+package io.nekohasekai.sagernet.bg.proto
+
+import io.nekohasekai.sagernet.SagerNet
+import io.nekohasekai.sagernet.bg.AbstractInstance
+import io.nekohasekai.sagernet.database.DataStore
+import io.nekohasekai.sagernet.database.ProxyEntity
+import io.nekohasekai.sagernet.ktx.Logs
+import kotlinx.coroutines.runBlocking
+import java.io.File
+
+/**
+ * XrayInstance: runs the official prebuilt Xray-core binary (shipped as
+ * libxray.so in jniLibs/<abi>) as a subprocess with a JSON config file.
+ *
+ * Mirrors how trojan-go / hysteria plugins are launched, avoiding gomobile-binding
+ * Xray-core (which pulls heavy deps and breaks the build).
+ */
+class XrayInstance(
+    override val profile: ProxyEntity,
+    val configFile: File,
+) : AbstractInstance {
+    private var process: Process? = null
+    private var launched: Boolean = false
+
+    private val binaryPath: String
+        get() = File(SagerNet.application.applicationInfo.nativeLibraryDir, "libxray.so").absolutePath
+
+    override fun launch() {
+        val cmd = mutableListOf(binaryPath, "run", "-c", configFile.absolutePath)
+        if (DataStore.logLevel > 0) cmd += listOf("-loglevel", "debug")
+        Logs.d("XrayInstance launching: ${cmd.joinToString(" ")}")
+        process = ProcessBuilder(cmd).redirectErrorStream(true).start()
+        launched = true
+    }
+
+    override fun isInitialized(): Boolean = launched
+
+    override fun close() {
+        runBlocking {
+            process?.destroy()
+            process = null
+            launched = false
+        }
+    }
+
+    override fun close(timeoutMillis: Long) = close()
+}
