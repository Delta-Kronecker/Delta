+++ b/app/src/main/java/io/nekohasekai/sagernet/fmt/xray/XrayConfigBuilder.kt
@@ -0,0 +1,173 @@
+package io.nekohasekai.sagernet.fmt.xray
+
+import io.nekohasekai.sagernet.fmt.v2ray.StandardV2RayBean
+import io.nekohasekai.sagernet.fmt.trojan.TrojanBean
+import io.nekohasekai.sagernet.fmt.v2ray.VMessBean
+import io.nekohasekai.sagernet.fmt.v2ray.isTLS
+import io.nekohasekai.sagernet.ktx.Logs
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * Builds an Xray-core JSON config from a parsed profile bean.
+ * Supports VLESS and Trojan outbound with common transports.
+ */
+object XrayConfigBuilder {
+
+    fun buildVless(bean: StandardV2RayBean): String {
+        val config = JSONObject()
+        val outbounds = JSONArray()
+        val outbound = JSONObject()
+
+        outbound.put("protocol", "vless")
+        val settings = JSONObject()
+        val vnext = JSONArray()
+        val server = JSONObject()
+        server.put("address", bean.serverAddress)
+        server.put("port", bean.serverPort)
+        val users = JSONArray()
+        val user = JSONObject()
+        user.put("id", bean.uuid)
+        user.put("encryption", bean.encryption.takeIf { it.isNotBlank() } ?: "none")
+        if (bean.encryption.isNotBlank() && bean.encryption != "none") user.put("flow", bean.encryption)
+        // ponytail: VLESS flow is stored in encryption field; if a dedicated flow field is added later, prefer it.
+        users.put(user)
+        server.put("users", users)
+        vnext.put(server)
+        settings.put("vnext", vnext)
+        outbound.put("settings", settings)
+
+        // stream settings
+        val stream = JSONObject()
+        stream.put("network", bean.type.takeIf { it.isNotBlank() } ?: "tcp")
+        stream.put("security", if (bean.isTLS()) "tls" else "none")
+
+        if (bean.isTLS()) {
+            val tls = JSONObject()
+            tls.put("serverName", bean.sni.takeIf { it.isNotBlank() } ?: bean.serverAddress)
+            if (bean.allowInsecure == true) tls.put("allowInsecure", true)
+            if (bean.alpn.isNotBlank()) tls.put("alpn", bean.alpn.listByLineOrComma())
+            if (bean.realityPubKey.isNotBlank()) {
+                val reality = JSONObject()
+                reality.put("show", false)
+                reality.put("fingerprint", bean.utlsFingerprint.takeIf { it.isNotBlank() } ?: "chrome")
+                reality.put("serverName", bean.sni.takeIf { it.isNotBlank() } ?: bean.serverAddress)
+                reality.put("publicKey", bean.realityPubKey)
+                reality.put("shortId", bean.realityShortId)
+                tls.put("realitySettings", reality)
+            } else if (bean.utlsFingerprint.isNotBlank()) {
+                val utls = JSONObject()
+                utls.put("enabled", true)
+                utls.put("fingerprint", bean.utlsFingerprint)
+                tls.put("utls", utls)
+            }
+            stream.put("tlsSettings", tls)
+        }
+
+        // transport
+        when (bean.type) {
+            "ws" -> {
+                val ws = JSONObject()
+                ws.put("path", bean.path.takeIf { it.isNotBlank() } ?: "/")
+                if (bean.host.isNotBlank()) ws.put("headers", JSONObject().put("Host", bean.host))
+                stream.put("wsSettings", ws)
+            }
+            "grpc" -> {
+                val grpc = JSONObject()
+                grpc.put("serviceName", bean.path)
+                stream.put("grpcSettings", grpc)
+            }
+            "httpupgrade" -> {
+                val hu = JSONObject()
+                hu.put("path", bean.path.takeIf { it.isNotBlank() } ?: "/")
+                if (bean.host.isNotBlank()) hu.put("host", bean.host)
+                stream.put("httpupgradeSettings", hu)
+            }
+            "xhttp" -> {
+                val xh = JSONObject()
+                xh.put("path", bean.path.takeIf { it.isNotBlank() } ?: "/")
+                if (bean.host.isNotBlank()) xh.put("host", bean.host)
+                stream.put("xhttpSettings", xh)
+            }
+        }
+
+        outbound.put("streamSettings", stream)
+        outbounds.put(outbound)
+
+        // inbounds: socks for local proxy
+        val inbounds = JSONArray()
+        val socksIn = JSONObject()
+        socksIn.put("port", 10808)
+        socksIn.put("listen", "127.0.0.1")
+        socksIn.put("protocol", "socks")
+        socksIn.put("settings", JSONObject().put("udp", true))
+        inbounds.put(socksIn)
+
+        config.put("inbounds", inbounds)
+        config.put("outbounds", outbounds)
+        config.put("log", JSONObject().put("loglevel", "warning"))
+
+        return config.toString(2)
+    }
+
+    fun buildTrojan(bean: TrojanBean): String {
+        val config = JSONObject()
+        val outbounds = JSONArray()
+        val outbound = JSONObject()
+
+        outbound.put("protocol", "trojan")
+        val settings = JSONObject()
+        val servers = JSONArray()
+        val server = JSONObject()
+        server.put("address", bean.serverAddress)
+        server.put("port", bean.serverPort)
+        server.put("password", bean.password)
+        servers.put(server)
+        settings.put("servers", servers)
+        outbound.put("settings", settings)
+
+        val stream = JSONObject()
+        stream.put("network", bean.type.takeIf { it.isNotBlank() } ?: "tcp")
+        stream.put("security", "tls")
+
+        val tls = JSONObject()
+        tls.put("serverName", bean.sni.takeIf { it.isNotBlank() } ?: bean.serverAddress)
+        if (bean.allowInsecure == true) tls.put("allowInsecure", true)
+        if (bean.alpn.isNotBlank()) tls.put("alpn", bean.alpn.listByLineOrComma())
+        stream.put("tlsSettings", tls)
+
+        when (bean.type) {
+            "ws" -> {
+                val ws = JSONObject()
+                ws.put("path", bean.path.takeIf { it.isNotBlank() } ?: "/")
+                if (bean.host.isNotBlank()) ws.put("headers", JSONObject().put("Host", bean.host))
+                stream.put("wsSettings", ws)
+            }
+            "grpc" -> {
+                val grpc = JSONObject()
+                grpc.put("serviceName", bean.path)
+                stream.put("grpcSettings", grpc)
+            }
+        }
+
+        outbound.put("streamSettings", stream)
+        outbounds.put(outbound)
+
+        val inbounds = JSONArray()
+        val socksIn = JSONObject()
+        socksIn.put("port", 10808)
+        socksIn.put("listen", "127.0.0.1")
+        socksIn.put("protocol", "socks")
+        socksIn.put("settings", JSONObject().put("udp", true))
+        inbounds.put(socksIn)
+
+        config.put("inbounds", inbounds)
+        config.put("outbounds", outbounds)
+        config.put("log", JSONObject().put("loglevel", "warning"))
+
+        return config.toString(2)
+    }
+
+    private fun String.listByLineOrComma(): List<String> =
+        this.split(Regex("[,\\n]")).map { it.trim() }.filter { it.isNotEmpty() }
+}
